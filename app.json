{
  "expo": {
    "name": "FoodLink",
    "slug": "foodlink-v2",
    "version": "3.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#F7F8F5"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "FoodLink necesita acceso a tus fotos para analizar alimentos.",
          "cameraPermission": "FoodLink necesita la cámara para escanear alimentos."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "FoodLink usa tu ubicación para mostrar donaciones cercanas."
        }
      ]
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.foodlink.app"
    },
    "android": {
      "package": "com.foodlink.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}
