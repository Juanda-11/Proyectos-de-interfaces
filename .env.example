# --- Vercel (Settings > Environment Variables) ---
# Proveedor de IA para /api/analyze (análisis de alimentos). Basta con configurar UNO.
# Gemini (recomendado, plan gratuito): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# Claude (de pago): https://console.anthropic.com
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
# Fuerza el proveedor si hay dos claves: gemini | anthropic
# AI_PROVIDER=gemini

# --- App móvil (Expo Go / builds nativos) ---
# URL pública del despliegue en Vercel, para que la app nativa llame a /api/analyze.
# En la versión web no hace falta: usa rutas relativas.
EXPO_PUBLIC_API_URL=
